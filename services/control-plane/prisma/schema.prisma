datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

enum SiteStatus {
  PENDING
  PROVISIONING
  READY
  FAILED
  SUSPENDED
}

enum ProvisionStatus {
  QUEUED
  PROVISIONING
  READY
  FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  sites  Site[]

  @@map("customers")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  price     Decimal  @default(0.00) @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  versions ProductVersion[]
  orders   Order[]
  sites    Site[]

  @@map("products")
}

model ProductVersion {
  id             String   @id @default(cuid())
  productId      String
  version        String
  dockerImageTag String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  Order[]
  sites   Site[]

  @@unique([productId, version])
  @@map("product_versions")
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  productId       String
  versionId       String?
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("USD")
  status          OrderStatus @default(AWAITING_PAYMENT)
  paymentIntentId String?
  createdAt       DateTime    @default(now())

  customer      Customer        @relation(fields: [customerId], references: [id])
  product       Product         @relation(fields: [productId], references: [id])
  version       ProductVersion? @relation(fields: [versionId], references: [id])
  site          Site?
  provisionJobs ProvisionJob[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model Site {
  id           String     @id @default(cuid())
  customerId   String
  productId    String
  versionId    String?
  orderId      String?    @unique
  name         String
  slug         String     @unique
  status       SiteStatus @default(PENDING)
  internalPort Int?
  databaseName String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer      Customer        @relation(fields: [customerId], references: [id])
  product       Product         @relation(fields: [productId], references: [id])
  version       ProductVersion? @relation(fields: [versionId], references: [id])
  order         Order?          @relation(fields: [orderId], references: [id])
  domains       SiteDomain[]
  provisionJobs ProvisionJob[]

  @@index([customerId])
  @@index([status])
  @@map("sites")
}

model SiteDomain {
  id        String   @id @default(cuid())
  siteId    String
  hostname  String   @unique
  isPrimary Boolean  @default(false)
  sslStatus String   @default("PENDING")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_domains")
}

model ProvisionJob {
  id           String          @id @default(cuid())
  siteId       String
  orderId      String?
  status       ProvisionStatus @default(QUEUED)
  currentStep  String?
  retryCount   Int             @default(0)
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  site  Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  order Order?         @relation(fields: [orderId], references: [id])
  logs  ProvisionLog[]

  @@index([siteId])
  @@index([status])
  @@map("provision_jobs")
}

model ProvisionLog {
  id        String   @id @default(cuid())
  jobId     String
  level     LogLevel @default(INFO)
  step      String?
  message   String
  createdAt DateTime @default(now())

  job ProvisionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("provision_logs")
}
